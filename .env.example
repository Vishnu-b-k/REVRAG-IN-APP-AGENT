# RevRag Orchestrator — Environment Configuration
# Copy to .env and fill in values

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# LLM Provider — "mock" (no API key needed) or "gemini" (requires LLM_API_KEY)
LLM_PROVIDER=mock

# Gemini API key — get from https://aistudio.google.com/app/apikey
# NEVER commit the real key to source control!
LLM_API_KEY=

# Model name — default: gemini-2.0-flash (fast + multimodal)
LLM_MODEL=gemini-2.0-flash

# API settings
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Exploration
MAX_STEP_BUDGET=50
SESSION_TIMEOUT_SECONDS=600
